# Name-that-face Client Configuration
# Copy this file to .env.client and fill in your actual values
# DO NOT commit .env.client to git - add it to .gitignore

# API Backend URL
# Local development: http://127.0.0.1:8000
# Local with ngrok tunnel: https://<ngrok-url>.ngrok-free.app
# Production: https://api.yourdomain.com
API_BASE_URL="http://127.0.0.1:8000"

# JWT Authentication
# Must match the SECRET_KEY in the server .env file
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM="HS256"

# User identification for testing
USER_ID="1"
USERNAME="user@example.com"

# User payload for identity verification test
USER_NAME="John Doe"
USER_EMAIL="user@example.com"
USER_AGE="30"

# Logging
CLIENT_LOG_PATH="/tmp/name_that_face_client.log"

# Optional: Streamlit app configuration
# Streamlit server port (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# Optional: Logging level
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
