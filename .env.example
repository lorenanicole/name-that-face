# Duo Security credentials — get these from your Duo Admin Panel
# https://admin.duosecurity.com → Applications → Auth API
DUO_INTEGRATION_KEY=your_duo_integration_key_here
DUO_SECRET_KEY=your_duo_secret_key_here
DUO_API_HOST=api-xxxxxxxx.duosecurity.com

# JWT signing secret — use a long random string in production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# Token TTL in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Path to config.yml (relative to where you run the server)
TOKEN_CONFIG_PATH=01_rate_limiter/config.yml

# --- Docker / deployment overrides (set automatically by docker-compose) ---
# DEEPFACE_PYTHON=/opt/deepface-venv/bin/python
# AUDIT_LOG_PATH=/app/logs/audit_log.jsonl
# LOG_FORMAT=json
# LOG_LEVEL=INFO
