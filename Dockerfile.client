# =============================================================================
# Dockerfile.client — Name-that-face Streamlit front-end
# =============================================================================
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir poetry \
    && poetry config virtualenvs.create false

COPY pyproject.toml poetry.lock ./
# Only needs the main group deps (streamlit, requests, pyjwt)
RUN poetry install --no-root --without deepface --without dev

COPY src/client.py .

# Client configuration — set at runtime via -e or docker-compose
# Example: docker run -e API_BASE_URL=https://api.example.com \
#                     -e JWT_SECRET=your-secret \
#                     -e USER_ID=1 \
#                     -e USERNAME=user@example.com
# Defaults for local docker-compose:
ENV API_BASE_URL=http://api:8000
ENV JWT_SECRET=test-secret-change-me
ENV USER_ID=test-user-1
ENV USERNAME=test@example.com
ENV USER_NAME=Test User
ENV USER_EMAIL=test@example.com
ENV USER_AGE=25
ENV CLIENT_LOG_PATH=/tmp/name_that_face_client.log

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "client.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
